NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_HOST=127.0.0.1
DATABASE_PORT=6432
DATABASE_USER=shankara_admin
DATABASE_PASSWORD=
DATABASE_NAME=shankara_erp

# pg-boss (catalog parse jobs) must talk to Postgres directly.
# PgBouncer transaction pooling breaks LISTEN/NOTIFY.
JOBS_DATABASE_PORT=5432

# Set true only when the API sits behind Caddy (or another reverse proxy).
TRUST_PROXY=false

POSTGRES_USER=shankara_admin
POSTGRES_PASSWORD=
POSTGRES_DB=shankara_erp

JWT_SECRET=
JWT_EXPIRES_IN=8h

STORAGE_DIR=./var/uploads
MAX_UPLOAD_BYTES=52428800
MAX_PARSE_ROWS=500000
DEBIT_CREDIT_TOLERANCE=0.05

SEED_STEWARD_PASSWORD=
SEED_FINANCE_PASSWORD=
SEED_BRANCH_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

--- item-master.service.ts
+++ item-master.service.ts
@@ -160,3 +160,2 @@
       batch.skippedRows = parsed.skippedRows;
-      batch.status = 'held';
 
@@ -198,3 +197,12 @@
 
-      await queryRunner.manager.save(batch);
+      const currentBatch = await queryRunner.manager.findOne(ItemMasterBatch, { where: { id: String(batchId) }, select: ['status'] });
+      if (currentBatch && currentBatch.status === 'processing') {
+        batch.status = 'held';
+        await queryRunner.manager.save(batch);
+      } else {
+        await this.auditService.log({
+          userId: 'system', action: 'item_status_override_warn', entityType: 'item_master_batch', entityId: batchId, meta: { originalStatus: 'processing', newStatus: currentBatch?.status }
+        }, queryRunner.manager);
+        await queryRunner.manager.save(batch); // Save counts but not status
+      }
       await queryRunner.commitTransaction();
@@ -231,2 +239,5 @@
     }
+    if (batch.status === 'processing') {
+      throw new BadRequestException('STILL_PROCESSING');
+    }
 
@@ -248,2 +259,5 @@
